# ==============================================================================
# HealthwithReshmi™ Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your real credentials:
# cp .env.example .env
# ==============================================================================

# --- EMAILJS CONFIGURATION ---
# https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=service_healthreshmi
VITE_EMAILJS_TEMPLATE_ID=template_contact_form
VITE_EMAILJS_BOOKING_TEMPLATE_ID=template_booking_alert
VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY

# --- RAZORPAY CONFIGURATION ---
# https://dashboard.razorpay.com/app/keys
# Public key for frontend checkout (Safe to expose)
VITE_RAZORPAY_KEY_ID=rzp_test_51234567890abc

# Private secret key for backend verification (NEVER expose to client!)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# --- CLINIC DETAILS ---
VITE_CLINIC_EMAIL=consult@reshmiverma.com
