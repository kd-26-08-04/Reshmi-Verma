{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/breathe", "destination": "/breathe.html" },
    { "source": "/nutrition", "destination": "/nutrition.html" },
    { "source": "/assessment", "destination": "/assessment.html" },
    { "source": "/booking", "destination": "/booking.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
